* PMOS ON: single-transistor leakage characterisation (Vg = 0, Vb = VDD)

.include ../../models/32nm_HP.pm
.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9

* Sample
.param vdd=0.909152 temp=52.5427 w=149.485n vd=0.652097 vs=0.199535
.param vth0=-0.522382 toxe=1.17556n ndep=3.21355e18 u0=0.0141608 xj=9.74731n
.param ldiff=64n
.csparam temp={temp} vth0={vth0} toxe={toxe} ndep={ndep} u0={u0} xj={xj}

M1 d g s b pmos W={w} L=32n AD={w*ldiff} AS={w*ldiff} PD={2*(w+ldiff)} PS={2*(w+ldiff)}
Vd d 0 dc {vd}
Vg g 0 dc 0
Vs s 0 dc {vs}
Vb b 0 dc {vdd}

.control
set numdgt=12
option temp=$&temp
altermod pmos vth0=$&vth0
altermod pmos toxe=$&toxe
altermod pmos ndep=$&ndep
altermod pmos u0=$&u0
altermod pmos xj=$&xj
op
print i(Vd) i(Vg) i(Vs) i(Vb)
.endc
.end
