* NMOS OFF: single-transistor leakage characterisation (Vg = 0, Vb = 0)

.include ../../models/32nm_HP.pm
.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9

* Sample
.param vdd=0.930800 temp=105.640 w=74.7242n vd=0.289647 vs=0.126553
.param vth0=0.494018 toxe=1.15922n ndep=4.24708e18 u0=0.0462785 xj=9.32652n
.param ldiff=64n
.csparam temp={temp} vth0={vth0} toxe={toxe} ndep={ndep} u0={u0} xj={xj}

M1 d g s b nmos W={w} L=32n AD={w*ldiff} AS={w*ldiff} PD={2*(w+ldiff)} PS={2*(w+ldiff)}
Vd d 0 dc {vd}
Vg g 0 dc 0
Vs s 0 dc {vs}
Vb b 0 dc 0

.control
set numdgt=12
option temp=$&temp
altermod nmos vth0=$&vth0
altermod nmos toxe=$&toxe
altermod nmos ndep=$&ndep
altermod nmos u0=$&u0
altermod nmos xj=$&xj
op
print i(Vd) i(Vg) i(Vs) i(Vb)
.endc
.end
