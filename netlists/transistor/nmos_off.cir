* nmos_off: single NMOS, one sample
.include ../../models/32nm_HP.pm
.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9
.temp 105.64

M1 d g s b nmos W=7.472417e-08 L=3.200000e-08 AD=4.782347e-15 AS=4.782347e-15 PD=2.774483e-07 PS=2.774483e-07
Vd d 0 dc 0.289647
Vg g 0 dc 0
Vs s 0 dc 0.126553
Vb b 0 dc 0

.control
altermod nmos vth0=4.940176369e-01
altermod nmos toxe=1.159219922e-09
altermod nmos ndep=4.247076022e+18
altermod nmos u0=4.627850626e-02
altermod nmos xj=9.326522233e-09
op
print i(Vd) i(Vg) i(Vs) i(Vb)
.endc
.end
